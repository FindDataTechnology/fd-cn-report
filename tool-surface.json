  "naming_convention": {
    "order": "verb_noun",
    "applies_to": "new_tools",
    "note": "新工具一律 `动词_名词`。既有工具名即此形态（list_/get_/extract_/search_/index_/delete_/clear_/audit_/open_）；不改名——改名会破坏已发布 pack 的引用。",
    "historical": "none",
    "prefix_policy": "跨服务同名工具不得靠前缀区分（前缀是服务标识而非工具语义）；同名消解靠描述里写明部署与数据源差异。"
  },
  "tool_groups": [
    {
      "group": "outline_extraction",
      "level": "commercial",
      "tools": [
        "extract_section",
        "list_outline"
      ],
      "description": "研报目录与分节抽取：list_outline 拉取年报/招股书等公告 PDF/HTML 并解析目录树，extract_section 按标题/正则/序号抽取单节正文。取回的原文落本地报告缓存、provenance（report_id/section 元数据）upsert 进本地 SQLite——均为透明记忆化，不改变任何面向用户的数据。"
    },
    {
      "group": "ai_extraction",
      "level": "commercial",
      "tools": [
        "ai_extract"
      ],
      "description": "LLM 结构化抽取：ai_extract 对分节文本按调用方给的 JSON Schema 抽记录数组（调外部 LLM，openWorld；无本地落库）。缓存与落库均由上层组合工具负责。"
    },
    {
      "group": "es_search",
      "level": "commercial",
      "tools": [
        "search_reports"
      ],
      "notes": "ES 检索面：按关键词搜已索引的报告（pack 引用的唯一 ES 工具）。"
    },
    {
      "group": "es_admin",
      "level": "internal",
      "tools": [
        "delete_index",
        "index_records"
      ],
      "notes": "ES 索引管理（建索引 / 删索引）。运维面误入 commercial，2026-11-25 降为 internal——无任何 pack 引用。"
    },
    {
      "group": "company_api",
      "level": "commercial",
      "tools": [
        "get_company",
        "get_filing",
        "get_financial_statements",
        "get_financials",
        "get_section",
        "get_special_report",
        "list_filings",
        "list_report_types"
      ],
      "description": "A 股公司画像与公告（巨潮 CNINFO 线）：公司解析 / 公告列表 / 单公告 / 三大报表结构化 / 便捷分节抽取 / 披露类别目录 / 特殊报告（招股、增发、业绩预告等）。便捷工具的 PDF 下载落报告缓存（透明记忆化）。"
    },
    {
      "group": "cache_mgmt",
      "level": "internal",
      "tools": [
        "clear_cache",
        "list_cache"
      ],
      "notes": "缓存管理（清缓存 / 看缓存）。运维面误入 commercial，2026-11-25 降为 internal——无任何 pack 引用。"
    },
    {
      "group": "indicator_rules",
      "level": "commercial",
      "tools": [
        "extract_indicators",
        "extract_indicators_by_position",
        "get_indicator",
        "list_indicators"
      ],
      "description": "银行业指标规则引擎：规则浏览（indicator_rules.json 驱动）、单指标解析（akshare/报告节/本地计算三路路由）、整包抽取（一次取 PDF + 分节批式 LLM + Python 抽取器 + 本地比率），bundle 落盘缓存供免费重跑（透明记忆化）。"
    },
    {
      "group": "hk_stock",
